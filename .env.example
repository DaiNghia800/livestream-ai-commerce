# .env.example — Template biến môi trường
# ============================================================
# HƯỚNG DẪN:
#   1. Copy file này thành .env ở máy local:  cp .env.example .env
#   2. Điền giá trị thực vào .env
#   3. TUYỆT ĐỐI KHÔNG commit file .env lên git
#   4. File .env.example được commit để team biết cần khai báo gì
# ============================================================

# ── Next.js (apps/web) ────────────────────────────────────────
# URL gốc của Commerce API (Node.js Express)
# NEXT_PUBLIC_ prefix → biến này lộ ra browser (chỉ dùng cho public URL)
NEXT_PUBLIC_COMMERCE_API_URL=http://localhost:8000

# Merchant ID mặc định cho môi trường phát triển (UUID).
# Màn tạo livestream và màn hàng đợi duyệt đều dùng mã này.
NEXT_PUBLIC_DEFAULT_MERCHANT_ID=a0000000-0000-0000-0000-000000000001

# URL của Realtime service (WebSocket)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8001

# ── Commerce Service (services/commerce) ──────────────────────
# Chuỗi kết nối PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/liveorder

# Cấu hình lưu trữ Amazon S3 (ảnh bìa livestream)
AWS_REGION=
S3_BUCKET_NAME=

# Secret key để ký JWT token (đặt chuỗi ngẫu nhiên dài ≥ 32 ký tự)
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-use-a-long-random-string-in-production

# TTL giữ hàng 2 tầng khi chốt đơn từ livestream (QĐ-1).
# Vừa chốt giữ 5 phút; khách mở link xác nhận thì gia hạn lên 15 phút;
# trần cứng 30 phút để không gia hạn vô hạn.
HOLD_SOFT_SECONDS=300
HOLD_CONFIRM_SECONDS=900
HOLD_MAX_SECONDS=1800

# Khoảng cách giữa hai lượt quét đơn quá hạn giữ hàng.
EXPIRE_JOB_INTERVAL_MS=30000

# Outbox publisher (T10): nơi nhận sự kiện order.* và inventory.changed
# để màn hình shop cập nhật tồn khả dụng theo thời gian thực.
#
# Khác NEXT_PUBLIC_REALTIME_URL ở trên: cái đó là WebSocket cho trình
# duyệt, cái này là đầu vào HTTP giữa hai service.
#
# ĐỂ TRỐNG là hợp lệ: services/realtime chưa dựng xong nên publisher
# chạy ở chế độ chỉ ghi log. Điền URL vào là gửi thật, không sửa code.
REALTIME_EVENTS_URL=
OUTBOX_JOB_INTERVAL_MS=2000

# ── Guard nghiệp vụ (T11) ──────────────────────────────────────
# BẪY-05: một dòng xin nhiều hơn mức này thì đẩy hàng đợi duyệt,
# nhưng VẪN giữ tồn — "cho e 100 cái" có thể là khách sỉ thật.
REVIEW_QTY_THRESHOLD=10

# BẪY-01: khách đã giữ tới mức này trong một phiên thì đẩy hàng đợi
# và KHÔNG giữ thêm. Ở đây rủi ro là troll khoá sạch mã hot.
#
# PHẢI lớn hơn hẳn REVIEW_QTY_THRESHOLD. Đặt bằng nhau thì mọi dòng
# vượt ngưỡng kia cũng vượt trần này, và nhánh "giữ tồn cho khách sỉ"
# của BẪY-05 không bao giờ chạy.
MAX_HELD_PER_CUSTOMER_PER_SESSION=30

# BẪY-08: 0.45 = ba lần chốt rồi bỏ, hoặc một lần nghi gian lận.
# Chạm ngưỡng thì TTL rút xuống HOLD_RISKY_SECONDS và chặn COD.
RISK_SCORE_THRESHOLD=0.45
HOLD_RISKY_SECONDS=180

# ── Cổng thanh toán điện tử — TOÀN BỘ LÀ SANDBOX ───────────────
# Hệ thống này KHÔNG nhận tiền thật. `assertSandbox()` trong
# payment-gateway.ts từ chối khởi tạo nếu URL trỏ ra ngoài danh sách
# host sandbox, nên một dòng chép nhầm từ tài liệu nhà cung cấp sẽ
# làm service báo lỗi ngay thay vì âm thầm thu tiền thật.

# Gốc đường dẫn của service, để cổng gọi ngược về.
PUBLIC_BASE_URL=http://localhost:8000

# mock | vnpay | momo | zalopay
# Mặc định "mock": cổng giả chạy trong máy, không cần đăng ký tài
# khoản thử ở đâu cả. Kéo repo về là chạy được trọn luồng thanh toán.
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=sandbox-only-secret

# VNPay sandbox — đăng ký tại https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo môi trường thử — https://developers.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create

# ZaloPay sandbox — https://docs.zalopay.vn
# Chú ý: KEY1 ký lúc tạo đơn, KEY2 xác thực callback. Dùng nhầm thì
# tạo được đơn nhưng mọi callback đều bị coi là giả mạo.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create

# ── AI Worker (services/ai-worker) ────────────────────────────
# Google Gemini API Key
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# URL kết nối SQS (dùng LocalStack khi dev local, SQS thật khi deploy)
SQS_QUEUE_URL=http://localhost:4566/000000000000/ai-tasks

# AWS credentials (dùng giả khi LocalStack, thật khi deploy)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-southeast-1

# ── Realtime Service (services/realtime) ──────────────────────
# Cùng DATABASE_URL với commerce service
# Lặp lại để mỗi service có thể deploy độc lập với .env riêng
REALTIME_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realtime_db

# ── Docker Compose (local dev) ────────────────────────────────
# Password cho PostgreSQL container
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=liveorder
